{
  "name": "unhinged",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:ios": "./scripts/build-ios.sh",
    "submit:ios": "eas submit --platform ios --path",
    "prebuild:android": "expo prebuild --platform android",
    "build:android": "./scripts/build-android.sh",
    "submit:android": "eas submit --platform android --path",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.32",
    "@amplitude/experiment-js-client": "^1.21.0",
    "@amplitude/plugin-session-replay-react-native": "^0.4.5",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.10",
    "axios": "^1.13.2",
    "customerio-expo-plugin": "^2.10.1",
    "customerio-reactnative": "^5.1.1",
    "expo": "^55.0.0",
    "expo-application": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.13",
    "expo-notifications": "~55.0.19",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.18",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.15",
    "expo-tracking-transparency": "~55.0.13",
    "lucide-react-native": "^0.554.0",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-fbsdk-next": "^13.4.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-purchases": "9.6.15",
    "react-native-purchases-ui": "9.6.15",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-skadnetwork": "^0.1.1",
    "react-native-svg": "15.15.3",
    "react-native-tiktok-business-sdk": "^1.6.2",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-svg-transformer": "^1.5.2",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@amplitude/analytics-react-native": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    }
  },
  "main": "expo-router/entry",
  "private": true
}
